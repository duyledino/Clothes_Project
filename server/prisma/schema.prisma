generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model User {
  user_id           String          @id @default(uuid())
  email             String          @unique
  password          String
  name              String?
  phone             String          @db.VarChar(10)
  address           String          @default("")
  create_at         DateTime        @default(now())
  update_at         DateTime        @updatedAt
  status            Boolean         @default(true)
  isVerify          Boolean         @default(false)
  verify_token      String?         
  expire_verify_at  DateTime?       
  forget_password_token  String?         
  expire_forget_password_at     DateTime?
  order_user_create Order[]         @relation("user_create")
  order_user_ship   Order[]         @relation("user_ship")
  carts             Cart?
  chat_message      Chat_Message[]
  review            Review[]
  stock_receipt     Stock_Receipt[]
  role              Role            @relation(fields: [role_id], references: [role_id])
  role_id           String

  chat_admin Chat[] @relation("chat_admin")
  chat_user Chat[] @relation("chat_user")
}

model Role {
  role_id   String @id @default(uuid())
  role_name String
  users     User[]
}

model Product {
  product_id           String                 @id @default(uuid())
  product_name         String
  price                BigInt
  description          String
  count                Int                    @default(0) // count purchasing total
  create_at            DateTime               @default(now())
  update_at            DateTime               @updatedAt
  imageUrl             String[]
  tryon                String
  status               String                 @default("active") // suspend, active
  order_detail         Order_Detail[]
  reviews              Review[]
  product_size         Product_Size[]
  Product_Category     Product_Category[]
  product_color        Product_Color[]
  cart_detail          Cart_Detail[]
  inventories          Inventory[]
  stock_receipt_detail Stock_Receipt_Detail[]
}

model Product_Category {
  product_id String
  category_id String
  product    Product? @relation(fields: [product_id], references: [product_id])
  category   Category? @relation(fields: [category_id], references: [category_id])
  @@id([product_id, category_id])
}


model Category {
  category_id   String    @id @default(uuid())
  category_name String
  Product_Category Product_Category[]
}

model Size {
  size_id              String                 @id @default(uuid())
  size_name            String
  product_size         Product_Size[]
  order_detail         Order_Detail[]
  cart_detail          Cart_Detail[]
  inventories          Inventory[]
  stock_receipt_detail Stock_Receipt_Detail[]
}

model Product_Size {
  product_id String
  size_id    String
  product    Product? @relation(fields: [product_id], references: [product_id])
  size       Size?    @relation(fields: [size_id], references: [size_id])

  @@id([product_id, size_id])
}

model Color {
  color_id             String                 @id @default(uuid())
  color_name           String
  product_color        Product_Color[]
  order_detail         Order_Detail[]
  cart_detail          Cart_Detail[]
  inventories          Inventory[]
  stock_receipt_detail Stock_Receipt_Detail[]
}

model Product_Color {
  product_id String
  color_id   String
  product    Product? @relation(fields: [product_id], references: [product_id])
  color      Color?   @relation(fields: [color_id], references: [color_id])

  @@id([product_id, color_id])
}

model Order {
  order_id      String         @id @default(uuid())
  user_id       String
  shipper_id    String?
  total         BigInt         @default(0)
  create_at     DateTime       @default(now())
  update_at     DateTime       @updatedAt
  method        String         @default("COD")
  payment       String         @default("pending") // done
  status        String         @default("pending") // canceled,shipping, done
  order_detail  Order_Detail[]
  user_create   User           @relation("user_create", fields: [user_id], references: [user_id])
  user_ship     User?          @relation("user_ship", fields: [shipper_id], references: [user_id])
  delivered_date DateTime?      
}

model Order_Detail {
  order_id   String
  product_id String
  size_id    String
  color_id   String
  quantity   Int     @default(0)
  price      BigInt  @default(0)
  subtotal   BigInt  @default(0)
  order      Order   @relation(fields: [order_id], references: [order_id])
  product    Product @relation(fields: [product_id], references: [product_id])
  color      Color   @relation(fields: [color_id], references: [color_id])
  size       Size    @relation(fields: [size_id], references: [size_id])

  @@id([product_id, order_id, size_id, color_id])
}

model Cart {
  cart_id     String        @id @default(uuid())
  user_id     String        @unique
  create_at   DateTime      @default(now())
  update_at   DateTime      @updatedAt
  user        User          @relation(fields: [user_id], references: [user_id])
  cart_detail Cart_Detail[]
}

model Cart_Detail {
  cart_id    String
  product_id String
  size_id    String
  color_id   String
  quantity   Int
  active     Boolean
  create_at  DateTime @default(now())
  update_at  DateTime @updatedAt
  cart       Cart     @relation(fields: [cart_id], references: [cart_id])
  product    Product  @relation(fields: [product_id], references: [product_id])
  size       Size     @relation(fields: [size_id], references: [size_id])
  color      Color    @relation(fields: [color_id], references: [color_id])

  @@id([cart_id, color_id, product_id, size_id])
}

model Review {
  product_id String
  user_id    String
  score      Int     @default(0)
  content    String  @default("")
  product    Product @relation(fields: [product_id], references: [product_id])
  user       User    @relation(fields: [user_id], references: [user_id])

  @@id([product_id, user_id])
}

model Chat {
  chat_id       String         @id @default(uuid())
  user_id_admin String
  user_id_user   String
  chat_message Chat_Message[]
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
  chat_admin User @relation("chat_admin", fields: [user_id_admin], references: [user_id])
  chat_user User @relation("chat_user", fields: [user_id_user], references: [user_id])
}

model Chat_Message {
  message_id String @id @default(uuid())
  chat_id    String
  user_id    String
  content   String
  create_at DateTime @default(now())
  chat      Chat   @relation(fields: [chat_id], references: [chat_id])
  user      User   @relation(fields: [user_id], references: [user_id])
}

model Inventory {
  inventory_id         String                 @unique @default(uuid())
  product_id           String
  size_id              String
  color_id             String
  quantity             Int                    @default(0)
  min_quantity         Int                    @default(0)
  create_at            DateTime               @default(now())
  update_at            DateTime               @updatedAt
  product              Product                @relation(fields: [product_id], references: [product_id])
  size                 Size                   @relation(fields: [size_id], references: [size_id])
  color                Color                  @relation(fields: [color_id], references: [color_id])
  stock_receipt_detail Stock_Receipt_Detail[]
  @@unique([product_id, size_id, color_id])
  @@id([inventory_id, product_id, color_id, size_id])
}

model Stock_Receipt {
  receipt_id           String                 @id @default(uuid())
  user_id              String
  provider_id          String
  user                User                   @relation(fields: [user_id], references: [user_id])
  providers            Provider               @relation(fields: [provider_id], references: [provider_id])
  create_at            DateTime               @default(now())
  stock_receipt_detail Stock_Receipt_Detail[]
}

model Stock_Receipt_Detail {
  receipt_id   String
  product_id   String
  size_id      String
  color_id     String
  inventory_id String
  quantity     Int
  receipt      Stock_Receipt @relation(fields: [receipt_id], references: [receipt_id])
  product      Product       @relation(fields: [product_id], references: [product_id])
  size         Size          @relation(fields: [size_id], references: [size_id])
  color        Color         @relation(fields: [color_id], references: [color_id])
  inventory    Inventory     @relation(fields: [inventory_id], references: [inventory_id])

  @@id([color_id, inventory_id, product_id, receipt_id, size_id])
}

model Provider {
  provider_id   String          @id @default(uuid())
  provider_name String
  // Add timestamps if needed
  create_at     DateTime        @default(now())
  update_at     DateTime        @updatedAt
  stock_receipt Stock_Receipt[]
}
